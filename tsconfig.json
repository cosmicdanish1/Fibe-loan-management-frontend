{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    /* Base Configuration */
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    
    /* Module Resolution */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    
    /* Output */
    "outDir": "./dist",
    "rootDir": "./src",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    
    /* Type Checking */
    "allowJs": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    
    /* React */
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "vite.config.ts",
    "tsconfig.electron.json",
    "tailwind.config.js",
    "postcss.config.js",
    "electron-builder.config.*"
  ]
}
