{
  "name": "electron-react-ts",
  "version": "1.3.0",
  "main": "dist/main/main.js",
  "scripts": {
    "predev": "node scripts/ensure-dist.js",
    "dev": "node scripts/wait-for-backend.js && concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:full": "concurrently --names \"BACKEND,VITE,ELECTRON\" --prefix-colors \"green,cyan,yellow\" \"npm run dev:backend\" \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:backend": "cd ../backend && npm run start:dev",
    "dev:vite": "vite --port 5177",
    "dev:electron": "wait-on tcp:5177 && cross-env IS_DEV=true electron .",
    "build": "npm run build:vite && npm run build:electron",
    "build:main": "tsc -p tsconfig.electron.json",
    "build:preload": "tsc src/main/preload.ts --outDir dist/main --module commonjs --esModuleInterop true --sourceMap true --declaration false --skipLibCheck true",
    "build:vite": "vite build",
    "build:electron": "npm run build:main && npm run build:preload && node scripts/copy-files.js",
    "preview": "vite preview",
    "electron:pack": "electron-builder",
    "electron:dist": "npm run build && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "quick-build": "npm run build:vite && npm run build:electron",
    "quick-run": "concurrently \"npm run dev:vite\" \"wait-on tcp:5177 && cross-env IS_DEV=true electron .\"",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:coverage": "vitest run tests/unit --coverage",
    "test:e2e": "playwright test tests/e2e",
    "test:stress": "playwright test tests/stress",
    "test:ui": "playwright test --ui",
    "test:all": "npm run test:unit && npm run test:e2e && npm run test:stress",
    "jest": "jest",
    "validate-routes": "ts-node scripts/validate-routes.ts"
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "vite"
  ],
  "author": "Paperwhite Technology",
  "license": "ISC",
  "description": "Fibe Loan Management System",
  "build": {
    "appId": "com.paperwhite.fibeloan",
    "productName": "Fibe Loan Management",
    "copyright": "Copyright © 2026 Paperwhite Technology",
    "directories": {
      "output": "release",
      "buildResources": "buildResources"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "buildResources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fibe Loan Management",
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName} frontend Setup ${version}.${ext}",
      "include": "buildResources/installer.nsh"
    },
    "publish": null
  },
  "dependencies": {
    "@ant-design/cssinjs": "^1.24.0",
    "@ant-design/icons": "^6.0.1",
    "@electron/remote": "^2.1.3",
    "@reduxjs/toolkit": "^2.11.2",
    "@types/file-saver": "^2.0.7",
    "@types/react-router-dom": "^5.3.3",
    "@types/uuid": "^10.0.0",
    "antd": "^5.27.3",
    "dayjs": "^1.11.18",
    "electron-log": "^5.4.4",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.541.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.8.2",
    "recharts": "^3.6.0",
    "redux-persist": "^6.0.0",
    "typescript": "^5.9.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/electron": "^1.4.38",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitejs/plugin-react-swc": "^4.0.1",
    "autoprefixer": "^10.4.21",
    "babel-jest": "^30.1.2",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "electron-squirrel-startup": "^1.0.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "jest-html-reporter": "^4.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "vite": "^7.1.1",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  }
}
