import React from 'react';
import { ChevronDown } from 'lucide-react';
import useDemandGeneration from '../hooks/useDemandGeneration';

// Main Component
const Generate: React.FC = () => {
  const { state, actions, options } = useDemandGeneration();
  const { formData, dropdowns } = state;

  return (
    <div className="min-h-screen bg-gray-100 p-6">
      <div className="max-w-4xl mx-auto bg-white rounded-lg shadow-md p-6">
        <h1 className="text-2xl font-bold text-gray-800 mb-6">Demand Generation</h1>
        
        <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
          {/* Month Dropdown */}
          <div className="relative dropdown-container">
            <label className="block text-sm font-medium text-gray-700 mb-1">Month</label>
            <div 
              className="w-full p-2 border border-gray-300 rounded-md cursor-pointer flex justify-between items-center"
              onClick={() => actions.toggleDropdown('month')}
            >
              <span>{formData.month || 'Select Month'}</span>
              <ChevronDown className={`w-4 h-4 transition-transform ${dropdowns.month ? 'transform rotate-180' : ''}`} />
            </div>
            {dropdowns.month && (
              <div className="absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-md shadow-lg">
                {options.months.map(month => (
                  <div
                    key={month}
                    className="p-2 hover:bg-gray-100 cursor-pointer"
                    onClick={() => {
                      actions.updateField('month', month);
                      actions.closeDropdown('month');
                    }}
                  >
                    {month}
                  </div>
                ))}
              </div>
            )}
          </div>

          {/* Year Dropdown */}
          <div className="relative dropdown-container">
            <label className="block text-sm font-medium text-gray-700 mb-1">Year</label>
            <div 
              className="w-full p-2 border border-gray-300 rounded-md cursor-pointer flex justify-between items-center"
              onClick={() => actions.toggleDropdown('year')}
            >
              <span>{formData.year || 'Select Year'}</span>
              <ChevronDown className={`w-4 h-4 transition-transform ${dropdowns.year ? 'transform rotate-180' : ''}`} />
            </div>
            {dropdowns.year && (
              <div className="absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-md shadow-lg">
                {options.years.map(year => (
                  <div
                    key={year}
                    className="p-2 hover:bg-gray-100 cursor-pointer"
                    onClick={() => {
                      actions.updateField('year', year);
                      actions.closeDropdown('year');
                    }}
                  >
                    {year}
                  </div>
                ))}
              </div>
            )}
          </div>

          {/* Division/RO Dropdown */}
          <div className="relative dropdown-container">
            <label className="block text-sm font-medium text-gray-700 mb-1">Division/RO</label>
            <div 
              className="w-full p-2 border border-gray-300 rounded-md cursor-pointer flex justify-between items-center"
              onClick={() => actions.toggleDropdown('divisionRO')}
            >
              <span>{formData.divisionRO || 'Select Division/RO'}</span>
              <ChevronDown className={`w-4 h-4 transition-transform ${dropdowns.divisionRO ? 'transform rotate-180' : ''}`} />
            </div>
            {dropdowns.divisionRO && (
              <div className="absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-md shadow-lg">
                {options.divisions.map(division => (
                  <div
                    key={division}
                    className="p-2 hover:bg-gray-100 cursor-pointer"
                    onClick={() => {
                      actions.updateField('divisionRO', division);
                      actions.closeDropdown('divisionRO');
                    }}
                  >
                    {division}
                  </div>
                ))}
              </div>
            )}
          </div>

          {/* To Dropdown */}
          <div className="relative dropdown-container">
            <label className="block text-sm font-medium text-gray-700 mb-1">To</label>
            <div 
              className="w-full p-2 border border-gray-300 rounded-md cursor-pointer flex justify-between items-center"
              onClick={() => actions.toggleDropdown('to')}
            >
              <span>{formData.to || 'Select Destination'}</span>
              <ChevronDown className={`w-4 h-4 transition-transform ${dropdowns.to ? 'transform rotate-180' : ''}`} />
            </div>
            {dropdowns.to && (
              <div className="absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-md shadow-lg">
                {options.destinations.map(dest => (
                  <div
                    key={dest}
                    className="p-2 hover:bg-gray-100 cursor-pointer"
                    onClick={() => {
                      actions.updateField('to', dest);
                      actions.closeDropdown('to');
                    }}
                  >
                    {dest}
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>

        {/* From Input */}
        <div className="mt-4">
          <label className="block text-sm font-medium text-gray-700 mb-1">From</label>
          <input
            type="text"
            value={formData.from}
            onChange={(e) => actions.updateField('from', e.target.value)}
            className="w-full p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            placeholder="Enter from details"
          />
        </div>

        {/* Action Buttons */}
        <div className="mt-6 flex justify-end space-x-4">
          <button
            onClick={actions.resetForm}
            className="px-4 py-2 bg-gray-200 text-gray-700 rounded-md hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-400"
          >
            Reset
          </button>
          <button
            onClick={actions.generateDemand}
            className="px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            Generate Demand
          </button>
        </div>
      </div>
    </div>
  );
};

export default Generate;
